<?xml version="1.0" encoding="UTF-8"?>
<ns0:definitions xmlns:ns0="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:ns2="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:ns3="http://www.omg.org/spec/DD/20100524/DC" xmlns:ns4="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Currency" targetNamespace="http://sberbank.example/currency" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.33.1">
  <ns0:message id="Message_ClientRequest" name="Запрос клиента на выдачу валюты" />
  <ns0:message id="Message_OperationCompleted" name="Результат завершённой операции" />
  <ns0:collaboration id="Collaboration_Currency">
    <ns0:participant id="Participant_Client" name="Клиент" processRef="Process_Client" />
    <ns0:participant id="Participant_FrontOffice" name="Пул 1: Обслуживание клиента и принятие решения" processRef="Process_Currency" />
    <ns0:participant id="Participant_Learning" name="Пул 2: Контур обратной связи и подготовки данных" processRef="Process_Learning" />
    <ns0:messageFlow id="MessageFlow_Request" name="Запрос на выдачу валюты" sourceRef="Client_SendRequest" targetRef="Start_Request" />
    <ns0:messageFlow id="MessageFlow_Learning" name="Событие о завершённой операции" sourceRef="Task_PublishKafka" targetRef="Start_Learning" />
  </ns0:collaboration>
  <ns0:process id="Process_Client" name="Запрос клиента" isExecutable="false">
    <ns0:startEvent id="Client_Start" name="Клиенту требуется иностранная валюта">
      <ns0:outgoing>C_F1</ns0:outgoing>
    </ns0:startEvent>
    <ns0:sendTask id="Client_SendRequest" name="Передать запрос кассиру" messageRef="Message_ClientRequest">
      <ns0:incoming>C_F1</ns0:incoming>
      <ns0:outgoing>C_F2</ns0:outgoing>
    </ns0:sendTask>
    <ns0:endEvent id="Client_End" name="Запрос передан">
      <ns0:incoming>C_F2</ns0:incoming>
    </ns0:endEvent>
    <ns0:sequenceFlow id="C_F1" sourceRef="Client_Start" targetRef="Client_SendRequest" />
    <ns0:sequenceFlow id="C_F2" sourceRef="Client_SendRequest" targetRef="Client_End" />
    <ns0:startEvent id="Event_08bdeqa" name="Результат получен" />
  </ns0:process>
  <ns0:process id="Process_Currency" name="Выдача наличной иностранной валюты" isExecutable="false">
    <ns0:laneSet id="LaneSet_Currency">
      <ns0:lane id="Lane_Operator" name="Операционист">
        <ns0:flowNodeRef>Task_ManualReview</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gateway_ManualDecision</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ManualReject</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ManualApprove</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_System" name="Система принятия решения и ML-контур">
        <ns0:flowNodeRef>Gateway_Merge</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_SaveResult</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_PublishKafka</ns0:flowNodeRef>
        <ns0:flowNodeRef>End_Currency</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_IdentityCheck</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_GetFeatures</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_LoadModel</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gateway_ServiceAvailable</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_FallbackReject</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gateway_Fallback</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_FallbackApprove</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gateway_Score</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_Inference</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_ReceiveRequest</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_LimitsCheck</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gateway_Limits</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_Approve</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_Escalate</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_IssueCurrency</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_NotifyRefusal</ns0:flowNodeRef>
        <ns0:flowNodeRef>Gateway_Identity</ns0:flowNodeRef>
      </ns0:lane>
      <ns0:lane id="Lane_Cashier" name="Кассир / кассовый терминал">
        <ns0:flowNodeRef>Task_EnterData</ns0:flowNodeRef>
        <ns0:flowNodeRef>Start_Request</ns0:flowNodeRef>
        <ns0:flowNodeRef>Task_SendRequest</ns0:flowNodeRef>
      </ns0:lane>
    </ns0:laneSet>
    <ns0:exclusiveGateway id="Gateway_Merge" name="Объединить результаты операции" gatewayDirection="Converging">
      <ns0:incoming>F23</ns0:incoming>
      <ns0:incoming>F24</ns0:incoming>
      <ns0:outgoing>F25</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:serviceTask id="Task_SaveResult" name="Сохранить скор, проверки и итог операции в PostgreSQL">
      <ns0:incoming>F25</ns0:incoming>
      <ns0:outgoing>F26</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:sendTask id="Task_PublishKafka" name="Опубликовать событие с результатом в Kafka" messageRef="Message_OperationCompleted">
      <ns0:incoming>F26</ns0:incoming>
      <ns0:outgoing>F27</ns0:outgoing>
    </ns0:sendTask>
    <ns0:endEvent id="End_Currency" name="Обслуживание клиента завершено">
      <ns0:incoming>F27</ns0:incoming>
    </ns0:endEvent>
    <ns0:serviceTask id="Task_IdentityCheck" name="Проверить личность клиента">
      <ns0:incoming>F03</ns0:incoming>
      <ns0:outgoing>F04</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:userTask id="Task_EnterData" name="Кассир вводит данные клиента и операции">
      <ns0:incoming>F01</ns0:incoming>
      <ns0:outgoing>F02</ns0:outgoing>
    </ns0:userTask>
    <ns0:startEvent id="Start_Request" name="Получен запрос клиента">
      <ns0:outgoing>F01</ns0:outgoing>
    </ns0:startEvent>
    <ns0:serviceTask id="Task_SendRequest" name="Передать запрос через API Gateway">
      <ns0:incoming>F02</ns0:incoming>
      <ns0:outgoing>F03</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_GetFeatures" name="Получить признаки из Feature Store">
      <ns0:incoming>F09Y</ns0:incoming>
      <ns0:outgoing>F10</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_LoadModel" name="Загрузить версию модели из Model Registry">
      <ns0:incoming>F10</ns0:incoming>
      <ns0:outgoing>F11</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:exclusiveGateway id="Gateway_ServiceAvailable" name="ML-сервис и данные доступны?" gatewayDirection="Diverging">
      <ns0:incoming>F08</ns0:incoming>
      <ns0:outgoing>F09Y</ns0:outgoing>
      <ns0:outgoing>F09N</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:serviceTask id="Task_FallbackReject" name="Применить резервное правило: отказать">
      <ns0:incoming>F16N</ns0:incoming>
      <ns0:outgoing>F18</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:exclusiveGateway id="Gateway_Fallback" name="Сумма менее 50 000 руб. и клиент VIP?" gatewayDirection="Diverging">
      <ns0:incoming>F09N</ns0:incoming>
      <ns0:outgoing>F16Y</ns0:outgoing>
      <ns0:outgoing>F16N</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:serviceTask id="Task_FallbackApprove" name="Применить резервное правило: предварительно одобрить">
      <ns0:incoming>F16Y</ns0:incoming>
      <ns0:outgoing>F17</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:exclusiveGateway id="Gateway_Score" name="Скор не ниже 0,85?" gatewayDirection="Diverging">
      <ns0:incoming>F12</ns0:incoming>
      <ns0:outgoing>F13Y</ns0:outgoing>
      <ns0:outgoing>F13N</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:serviceTask id="Task_Inference" name="Рассчитать скор с помощью ML-модели">
      <ns0:incoming>F11</ns0:incoming>
      <ns0:outgoing>F12</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_ReceiveRequest" name="Передать запрос в ML Inference Service">
      <ns0:incoming>F07N</ns0:incoming>
      <ns0:outgoing>F08</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_LimitsCheck" name="Проверить ограничения валютной операции">
      <ns0:incoming>F05Y</ns0:incoming>
      <ns0:outgoing>F06</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:exclusiveGateway id="Gateway_Limits" name="Операция соответствует ограничениям?" gatewayDirection="Diverging">
      <ns0:incoming>F06</ns0:incoming>
      <ns0:outgoing>F07N</ns0:outgoing>
      <ns0:outgoing>Flow_0dykun9</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:serviceTask id="Task_Approve" name="Сформировать предварительный вердикт: одобрить">
      <ns0:incoming>F13Y</ns0:incoming>
      <ns0:outgoing>F14</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_Escalate" name="Передать запрос на ручную проверку">
      <ns0:incoming>F13N</ns0:incoming>
      <ns0:outgoing>F15</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:userTask id="Task_ManualReview" name="Операционист проверяет операцию вручную">
      <ns0:incoming>F15</ns0:incoming>
      <ns0:outgoing>F19</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_IssueCurrency" name="Выдать валюту клиенту">
      <ns0:incoming>F14</ns0:incoming>
      <ns0:incoming>F17</ns0:incoming>
      <ns0:incoming>F21</ns0:incoming>
      <ns0:outgoing>F23</ns0:outgoing>
    </ns0:userTask>
    <ns0:exclusiveGateway id="Gateway_ManualDecision" name="Операционист одобрил операцию?" gatewayDirection="Diverging">
      <ns0:incoming>F19</ns0:incoming>
      <ns0:outgoing>F20Y</ns0:outgoing>
      <ns0:outgoing>F20N</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:userTask id="Task_ManualReject" name="Отклонить выдачу валюты">
      <ns0:incoming>F20N</ns0:incoming>
      <ns0:outgoing>Flow_1tudm1y</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_ManualApprove" name="Подтвердить выдачу валюты">
      <ns0:incoming>F20Y</ns0:incoming>
      <ns0:outgoing>F21</ns0:outgoing>
    </ns0:userTask>
    <ns0:userTask id="Task_NotifyRefusal" name="Сообщить клиенту об отказе">
      <ns0:incoming>F18</ns0:incoming>
      <ns0:incoming>Flow_1tudm1y</ns0:incoming>
      <ns0:incoming>Flow_102gh6i</ns0:incoming>
      <ns0:incoming>Flow_0dykun9</ns0:incoming>
      <ns0:outgoing>F24</ns0:outgoing>
    </ns0:userTask>
    <ns0:sequenceFlow id="F23" sourceRef="Task_IssueCurrency" targetRef="Gateway_Merge" />
    <ns0:sequenceFlow id="F24" sourceRef="Task_NotifyRefusal" targetRef="Gateway_Merge" />
    <ns0:sequenceFlow id="F25" sourceRef="Gateway_Merge" targetRef="Task_SaveResult" />
    <ns0:sequenceFlow id="F26" sourceRef="Task_SaveResult" targetRef="Task_PublishKafka" />
    <ns0:sequenceFlow id="F27" sourceRef="Task_PublishKafka" targetRef="End_Currency" />
    <ns0:sequenceFlow id="F03" sourceRef="Task_SendRequest" targetRef="Task_IdentityCheck" />
    <ns0:sequenceFlow id="F04" sourceRef="Task_IdentityCheck" targetRef="Gateway_Identity" />
    <ns0:sequenceFlow id="F05Y" name="Да" sourceRef="Gateway_Identity" targetRef="Task_LimitsCheck">
      <ns0:conditionExpression xsi:type="ns0:tFormalExpression">identityValid == true</ns0:conditionExpression>
    </ns0:sequenceFlow>
    <ns0:sequenceFlow id="F01" sourceRef="Start_Request" targetRef="Task_EnterData" />
    <ns0:sequenceFlow id="F02" sourceRef="Task_EnterData" targetRef="Task_SendRequest" />
    <ns0:sequenceFlow id="F09Y" name="Да" sourceRef="Gateway_ServiceAvailable" targetRef="Task_GetFeatures">
      <ns0:conditionExpression xsi:type="ns0:tFormalExpression">mlAvailable == true and featuresAvailable == true</ns0:conditionExpression>
    </ns0:sequenceFlow>
    <ns0:sequenceFlow id="F10" sourceRef="Task_GetFeatures" targetRef="Task_LoadModel" />
    <ns0:sequenceFlow id="F11" sourceRef="Task_LoadModel" targetRef="Task_Inference" />
    <ns0:sequenceFlow id="F08" sourceRef="Task_ReceiveRequest" targetRef="Gateway_ServiceAvailable" />
    <ns0:sequenceFlow id="F09N" name="Нет / ошибка / таймаут" sourceRef="Gateway_ServiceAvailable" targetRef="Gateway_Fallback">
      <ns0:conditionExpression xsi:type="ns0:tFormalExpression">mlAvailable == false or featuresAvailable == false</ns0:conditionExpression>
    </ns0:sequenceFlow>
    <ns0:sequenceFlow id="F16N" name="Нет" sourceRef="Gateway_Fallback" targetRef="Task_FallbackReject">
      <ns0:conditionExpression xsi:type="ns0:tFormalExpression">amount &gt;= 50000 or vip == false</ns0:conditionExpression>
    </ns0:sequenceFlow>
    <ns0:sequenceFlow id="F18" sourceRef="Task_FallbackReject" targetRef="Task_NotifyRefusal" />
    <ns0:sequenceFlow id="F16Y" name="Да" sourceRef="Gateway_Fallback" targetRef="Task_FallbackApprove">
      <ns0:conditionExpression xsi:type="ns0:tFormalExpression">amount &lt; 50000 and vip == true</ns0:conditionExpression>
    </ns0:sequenceFlow>
    <ns0:sequenceFlow id="F17" sourceRef="Task_FallbackApprove" targetRef="Task_IssueCurrency" />
    <ns0:sequenceFlow id="F12" sourceRef="Task_Inference" targetRef="Gateway_Score" />
    <ns0:sequenceFlow id="F13Y" name="Да" sourceRef="Gateway_Score" targetRef="Task_Approve">
      <ns0:conditionExpression xsi:type="ns0:tFormalExpression">score &gt;= 0.85</ns0:conditionExpression>
    </ns0:sequenceFlow>
    <ns0:sequenceFlow id="F13N" name="Нет" sourceRef="Gateway_Score" targetRef="Task_Escalate">
      <ns0:conditionExpression xsi:type="ns0:tFormalExpression">score &lt; 0.85</ns0:conditionExpression>
    </ns0:sequenceFlow>
    <ns0:sequenceFlow id="F07N" name="Нет" sourceRef="Gateway_Limits" targetRef="Task_ReceiveRequest">
      <ns0:conditionExpression xsi:type="ns0:tFormalExpression">limitsValid == false</ns0:conditionExpression>
    </ns0:sequenceFlow>
    <ns0:sequenceFlow id="F06" sourceRef="Task_LimitsCheck" targetRef="Gateway_Limits" />
    <ns0:sequenceFlow id="F14" sourceRef="Task_Approve" targetRef="Task_IssueCurrency" />
    <ns0:sequenceFlow id="F15" sourceRef="Task_Escalate" targetRef="Task_ManualReview" />
    <ns0:sequenceFlow id="F19" sourceRef="Task_ManualReview" targetRef="Gateway_ManualDecision" />
    <ns0:sequenceFlow id="F21" sourceRef="Task_ManualApprove" targetRef="Task_IssueCurrency" />
    <ns0:sequenceFlow id="F20Y" name="Да" sourceRef="Gateway_ManualDecision" targetRef="Task_ManualApprove">
      <ns0:conditionExpression xsi:type="ns0:tFormalExpression">manualDecision == 'APPROVE'</ns0:conditionExpression>
    </ns0:sequenceFlow>
    <ns0:sequenceFlow id="F20N" name="Нет" sourceRef="Gateway_ManualDecision" targetRef="Task_ManualReject">
      <ns0:conditionExpression xsi:type="ns0:tFormalExpression">manualDecision == 'REJECT'</ns0:conditionExpression>
    </ns0:sequenceFlow>
    <ns0:sequenceFlow id="Flow_1tudm1y" sourceRef="Task_ManualReject" targetRef="Task_NotifyRefusal" />
    <ns0:sequenceFlow id="Flow_102gh6i" sourceRef="Gateway_Identity" targetRef="Task_NotifyRefusal" />
    <ns0:exclusiveGateway id="Gateway_Identity" name="Личность подтверждена?" gatewayDirection="Diverging">
      <ns0:incoming>F04</ns0:incoming>
      <ns0:outgoing>F05Y</ns0:outgoing>
      <ns0:outgoing>Flow_102gh6i</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_0dykun9" sourceRef="Gateway_Limits" targetRef="Task_NotifyRefusal" />
  </ns0:process>
  <ns0:process id="Process_Learning" name="Обратная связь и подготовка данных" isExecutable="false">
    <ns0:startEvent id="Start_Learning" name="Получено событие о завершённой операции">
      <ns0:outgoing>L01</ns0:outgoing>
    </ns0:startEvent>
    <ns0:serviceTask id="Task_GetLabels" name="Получить скор, итоговое решение и фактический статус операции">
      <ns0:incoming>L01</ns0:incoming>
      <ns0:outgoing>L02</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:serviceTask id="Task_UpdateDataset" name="Сформировать и обновить размеченную запись датасета">
      <ns0:incoming>L02</ns0:incoming>
      <ns0:outgoing>L03</ns0:outgoing>
    </ns0:serviceTask>
    <ns0:task id="Task_QualityMonitoring" name="Передать данные для оценки качества и следующего цикла обучения">
      <ns0:incoming>L03</ns0:incoming>
      <ns0:outgoing>L04</ns0:outgoing>
    </ns0:task>
    <ns0:endEvent id="End_Learning" name="Данные переданы в контур обучения">
      <ns0:incoming>L04</ns0:incoming>
    </ns0:endEvent>
    <ns0:sequenceFlow id="L01" sourceRef="Start_Learning" targetRef="Task_GetLabels" />
    <ns0:sequenceFlow id="L02" sourceRef="Task_GetLabels" targetRef="Task_UpdateDataset" />
    <ns0:sequenceFlow id="L03" sourceRef="Task_UpdateDataset" targetRef="Task_QualityMonitoring" />
    <ns0:sequenceFlow id="L04" sourceRef="Task_QualityMonitoring" targetRef="End_Learning" />
  </ns0:process>
  <ns2:BPMNDiagram id="BPMNDiagram_Currency">
    <ns2:BPMNPlane id="BPMNPlane_Currency" bpmnElement="Collaboration_Currency">
      <ns2:BPMNShape id="Participant_FrontOffice_di_di" bpmnElement="Participant_FrontOffice" isHorizontal="true">
        <ns3:Bounds x="160" y="280" width="3980" height="800" />
      </ns2:BPMNShape>
      <ns2:BPMNShape id="Lane_Operator_di_di" bpmnElement="Lane_Operator" isHorizontal="true">
        <ns3:Bounds x="190" y="880" width="3950" height="200" />
      </ns2:BPMNShape>
      <ns2:BPMNShape id="Lane_System_di_di" bpmnElement="Lane_System" isHorizontal="true">
        <ns3:Bounds x="190" y="450" width="3950" height="430" />
        <ns2:BPMNLabel />
      </ns2:BPMNShape>
      <ns2:BPMNShape id="Lane_Cashier_di_di" bpmnElement="Lane_Cashier" isHorizontal="true">
        <ns3:Bounds x="190" y="280" width="3950" height="170" />
      </ns2:BPMNShape>
      <ns2:BPMNShape id="Gateway_Merge_di" bpmnElement="Gateway_Merge" isMarkerVisible="true">
        <ns3:Bounds x="3520" y="500" width="50" height="50" />
        <ns2:BPMNLabel>
          <ns3:Bounds x="3513" y="450" width="63" height="40" />
        </ns2:BPMNLabel>
      </ns2:BPMNShape>
      <ns2:BPMNShape id="Task_SaveResult_di" bpmnElement="Task_SaveResult">
        <ns3:Bounds x="3610" y="485" width="180" height="80" />
      </ns2:BPMNShape>
      <ns2:BPMNShape id="Task_PublishKafka_di" bpmnElement="Task_PublishKafka">
        <ns3:Bounds x="3820" y="485" width="180" height="80" />
      </ns2:BPMNShape>
      <ns2:BPMNShape id="End_Currency_di" bpmnElement="End_Currency">
        <ns3:Bounds x="4040" y="507" width="36" height="36" />
        <ns2:BPMNLabel>
          <ns3:Bounds x="4020" y="543" width="76" height="40" />
        </ns2:BPMNLabel>
      </ns2:BPMNShape>
      <ns2:BPMNShape id="Task_IdentityCheck_di" bpmnElement="Task_IdentityCheck">
        <ns3:Bounds x="730" y="660" width="160" height="80" />
      </ns2:BPMNShape>
      <ns2:BPMNShape id="Task_EnterData_di" bpmnElement="Task_EnterData">
        <ns3:Bounds x="375" y="320" width="150" height="80" />
      </ns2:BPMNShape>
      <ns2:BPMNShape id="Start_Request_di" bpmnElement="Start_Request">
        <ns3:Bounds x="272" y="342" width="36" height="36" />
        <ns2:BPMNLabel>
          <ns3:Bounds x="249" y="387.5" width="82" height="27" />
        </ns2:BPMNLabel>
      </ns2:BPMNShape>
      <ns2:BPMNShape id="Task_SendRequest_di" bpmnElement="Task_SendRequest">
        <ns3:Bounds x="570" y="320" width="160" height="80" />
      </ns2:BPMNShape>
      <ns2:BPMNShape id="Task_GetFeatures_di" bpmnElement="Task_GetFeatures">
        <ns3:Bounds x="1700" y="470" width="160" height="80" />
      </ns2:BPMNShape>
      <ns2:BPMNShape id="Task_LoadModel_di" bpmnElement="Task_LoadModel">
        <ns3:Bounds x="1900" y="470" width="160" height="80" />
      </ns2:BPMNShape>
      <ns2:BPMNShape id="Gateway_ServiceAvailable_di" bpmnElement="Gateway_ServiceAvailable" isMarkerVisible="true">
        <ns3:Bounds x="1633" y="575" width="50" height="50" />
        <ns2:BPMNLabel>
          <ns3:Bounds x="1678" y="580" width="64" height="40" />
        </ns2:BPMNLabel>
      </ns2:BPMNShape>
      <ns2:BPMNShape id="Task_FallbackReject_di" bpmnElement="Task_FallbackReject">
        <ns3:Bounds x="1830" y="610" width="180" height="80" />
      </ns2:BPMNShape>
      <ns2:BPMNShape id="Gateway_Fallback_di" bpmnElement="Gateway_Fallback" isMarkerVisible="true">
        <ns3:Bounds x="1695" y="675" width="50" height="50" />
        <ns2:BPMNLabel>
          <ns3:Bounds x="1745" y="680" width="90" height="40" />
        </ns2:BPMNLabel>
      </ns2:BPMNShape>
      <ns2:BPMNShape id="Task_FallbackApprove_di" bpmnElement="Task_FallbackApprove">
